# MongoDB (the app accepts MONGGO_URI exactly as requested; MONGO_URI also works as fallback)
MONGGO_URI=mongodb+srv://username:password@cluster.mongodb.net/bib?retryWrites=true&w=majority

# Google Service Account - enable Google Drive API and share each event folder with GOOGLE_CLIENT_EMAIL
GOOGLE_PROJECT_ID=your-google-cloud-project-id
GOOGLE_CLIENT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# Admin login
ADMIN_USERNAME=admin
# Local quick start only. Prefer ADMIN_PASSWORD_HASH on Vercel/production.
ADMIN_PASSWORD=change-me
# Generate with: npm run hash-password -- "your-password"
# ADMIN_PASSWORD_HASH=$2a$12$...

# At least 32 random characters. Example: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret

# Optional public site title
NEXT_PUBLIC_SITE_NAME=BIBPIX
